{
  "name": "luma",
  "productName": "Luma",
  "version": "0.1.0",
  "description": "Luma — a visual Git-first IDE for Linux. See your history, stage by drag & drop, resolve conflicts visually.",
  "main": "out/main/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/drainedgodw/Luma.git"
  },
  "author": "Luma contributors",
  "engines": {
    "node": ">=22.20 <23",
    "npm": ">=10"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.25.12": true,
    "node-pty@1.1.0": true
  },
  "scripts": {
    "postinstall": "node scripts/verify-install.cjs",
    "doctor": "node scripts/verify-install.cjs",
    "predev": "node scripts/verify-install.cjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prestart": "node scripts/verify-install.cjs",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --linux",
    "predist": "node scripts/verify-install.cjs && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "^33.4.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.1.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-javascript": "^6.2.3",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/lang-python": "^6.1.7",
    "@codemirror/language": "^6.10.8",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
